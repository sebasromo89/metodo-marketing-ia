# Copia este archivo como herramientas/.env y pega tus llaves después del signo =
# Nunca compartas este archivo ni lo subas a git.

# Token personal de Apify (apify.com > Settings > API & Integrations)
APIFY_TOKEN=

# API key de Gemini (aistudio.google.com > Get API key)
GEMINI_API_KEY=

# Opcional: modelo de Gemini a usar (por defecto gemini-3.5-flash)
# GEMINI_MODEL=
